# ============================================================
# 環境変数テンプレート
# .env にコピーして実際の値を設定してください
# ============================================================

# --- Threads API (Meta) ---
THREADS_APP_ID=your_app_id_here
THREADS_APP_SECRET=your_app_secret_here
THREADS_ACCESS_TOKEN=your_long_lived_token_here
THREADS_USER_ID=your_threads_user_id_here

# --- Claude API (Anthropic) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- YouTube Data API ---
YOUTUBE_API_KEY=your_youtube_api_key_here

# --- Gmail通知 (Notifier) ---
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16char_app_password
GMAIL_TO=your_gmail_address@gmail.com  # 省略時は GMAIL_USER と同じ

# --- Telegram通知 ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
